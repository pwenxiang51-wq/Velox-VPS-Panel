    echo -e "  ${cyan}m.${plain} 🎛️ ${cyan}模块启停 (物理拔管)${plain}   |  ${cyan}n.${plain} 🔄 ${cyan}重置订阅链接 (防白嫖)${plain}"
    echo -e "  ${cyan}o.${plain} 🔄 ${yellow}核心强启 (满血复活)${plain}   |  ${cyan}p.${plain} 📡 ${yellow}双栈网络寻址热变阵${plain}"
    echo -e "  ${cyan}q.${plain} 🔄 ${cyan}版本回滚（历史切换)${plain}   |  ${cyan}0.${plain} 🔙 ${cyan}退出终端${plain}"
